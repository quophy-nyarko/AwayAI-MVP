{
  "name": "awayai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/server",
    "apps/mobile"
  ],
  "scripts": {
    "dev:server": "npm --workspace apps/server run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "web": "npm --workspace apps/mobile run web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace apps/server"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
