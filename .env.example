# Server
PORT=8787
NODE_ENV=development
APP_ADMIN_TOKEN=change-this-to-a-long-random-token
META_VERIFY_TOKEN=change-this-webhook-verification-token
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0

# Any OpenAI-compatible chat-completions provider
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Comma-separated web origins. Leave blank during local development.
ALLOWED_ORIGINS=
DATA_FILE=./data/store.json
DEMO_MODE=true

# Mobile (set before an Android build)
EXPO_PUBLIC_API_URL=https://your-api.example.com
EXPO_PUBLIC_APP_TOKEN=use-the-same-value-as-APP_ADMIN_TOKEN
